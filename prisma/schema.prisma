generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SUPPORT
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  DRAFT
  AWAITING_PAYMENT
  PROOF_UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DELIVERING
  COMPLETED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentMethod {
  EZCASH
  BANK
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DeliveryType {
  COMMAND
  MANUAL
}

enum DeliveryStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  MANUAL
}

enum ProductCategory {
  RANK
  UPGRADE
  KEY
  SHARDS
  OTHER
}

enum VerificationPurpose {
  REGISTER
  LOGIN
  RESET
  EMAIL_CHANGE
}

enum CouponType {
  PERCENTAGE
  FIXED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

model User {
  id                 String    @id @default(cuid())
  publicId           String    @unique @map("public_id") @db.Char(15)
  email              String    @unique @db.VarChar(191)
  passwordHash       String    @map("password_hash")
  role               Role      @default(CUSTOMER)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isFounder          Boolean   @default(false) @map("is_founder")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  totpSecret         String?   @map("totp_secret") @db.Text
  totpEnabled        Boolean   @default(false) @map("totp_enabled")
  isSuspended        Boolean   @default(false) @map("is_suspended")
  failedLogins       Int       @default(0) @map("failed_logins")
  lockedUntil        DateTime? @map("locked_until")
  lastLoginAt        DateTime? @map("last_login_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  profile      Profile?
  sessions     Session[]
  recovery     RecoveryCode[]
  orders       Order[]
  reviewed     Order[]             @relation("OrderReviewer")
  proofs       PaymentProof[]      @relation("ProofReviewer")
  notifications Notification[]
  auditLogs    AuditLog[]          @relation("AuditActor")
  redemptions  CouponRedemption[]

  @@index([role])
  @@map("users")
}

model Profile {
  id                String    @id @default(cuid())
  userId            String    @unique @map("user_id")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  displayName       String?   @map("display_name")
  birthday          DateTime? @db.Date
  avatarUrl         String?   @map("avatar_url")
  timezone          String    @default("Asia/Colombo")
  country           String?
  bio               String?   @db.Text
  marketingOptIn    Boolean   @default(false) @map("marketing_opt_in")
  minecraftUsername String?   @map("minecraft_username")
  minecraftUuid     String?   @map("minecraft_uuid")
  discordId         String?   @map("discord_id")
  setupStep         Int       @default(1) @map("setup_step")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model VerificationCode {
  id         String              @id @default(cuid())
  email      String              @db.VarChar(191)
  purpose    VerificationPurpose
  codeHash   String              @map("code_hash")
  attempts   Int                 @default(0)
  expiresAt  DateTime            @map("expires_at")
  consumedAt DateTime?           @map("consumed_at")
  ip         String?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("verification_codes")
}

model Session {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  ip         String?
  userAgent  String?   @map("user_agent") @db.Text
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RecoveryCode {
  id       String    @id @default(cuid())
  userId   String    @map("user_id")
  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

model Product {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  category        ProductCategory
  priceMinor      BigInt          @map("price_minor")
  currency        String          @default("LKR") @db.Char(3)
  description     String?         @db.Text
  perks           Json?
  color           String?
  dark            String?
  imageUrl        String?         @map("image_url")
  badge           String?
  popular         Boolean         @default(false)
  active          Boolean         @default(true)
  sortOrder       Int             @default(0) @map("sort_order")
  deliveryType    DeliveryType    @default(MANUAL) @map("delivery_type")
  deliveryCommand String?         @map("delivery_command") @db.Text
  serverId        String?         @map("server_id")
  fromProductId   String?         @map("from_product_id")
  toProductId     String?         @map("to_product_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  server     Server?     @relation(fields: [serverId], references: [id])
  orderItems OrderItem[]

  @@index([category, active, sortOrder])
  @@map("products")
}

model PaymentAccount {
  id            String        @id @default(cuid())
  method        PaymentMethod
  label         String
  accountName   String        @map("account_name")
  accountNumber String        @map("account_number")
  bankName      String?       @map("bank_name")
  branch        String?
  instructions  String?       @db.Text
  qrImageUrl    String?       @map("qr_image_url")
  iconKey       String?       @map("icon_key")
  active        Boolean       @default(true)
  sortOrder     Int           @default(0) @map("sort_order")

  orders Order[]

  @@map("payment_accounts")
}

model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique @map("order_number")
  userId            String        @map("user_id")
  status            OrderStatus   @default(AWAITING_PAYMENT)
  subtotalMinor     BigInt        @map("subtotal_minor")
  discountMinor     BigInt        @default(0) @map("discount_minor")
  totalMinor        BigInt        @map("total_minor")
  currency          String        @default("LKR") @db.Char(3)
  paymentMethod     PaymentMethod @map("payment_method")
  paymentAccountId  String?       @map("payment_account_id")
  paymentReference  String        @unique @map("payment_reference")
  minecraftUsername String        @map("minecraft_username")
  customerNote      String?       @map("customer_note") @db.Text
  internalNote      String?       @map("internal_note") @db.Text
  expiresAt         DateTime      @map("expires_at")
  paidAt            DateTime?     @map("paid_at")
  reviewedById      String?       @map("reviewed_by_id")
  reviewedAt        DateTime?     @map("reviewed_at")
  rejectionReason   String?       @map("rejection_reason") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user           User            @relation(fields: [userId], references: [id])
  reviewedBy     User?           @relation("OrderReviewer", fields: [reviewedById], references: [id])
  paymentAccount PaymentAccount? @relation(fields: [paymentAccountId], references: [id])
  items          OrderItem[]
  proofs         PaymentProof[]
  events         OrderEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id            String @id @default(cuid())
  orderId       String @map("order_id")
  productId     String @map("product_id")
  nameSnapshot  String @map("name_snapshot")
  priceMinor    BigInt @map("price_minor")
  quantity      Int    @default(1)
  perksSnapshot Json?  @map("perks_snapshot")

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])
  deliveries Delivery[]

  @@index([orderId])
  @@map("order_items")
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  type      String
  actorId   String?  @map("actor_id")
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model PaymentProof {
  id           String      @id @default(cuid())
  orderId      String      @map("order_id")
  fileKey      String      @map("file_key")
  originalName String      @map("original_name")
  mime         String
  sizeBytes    Int         @map("size_bytes")
  sha256       String      @db.Char(64)
  status       ProofStatus @default(PENDING)
  reviewedById String?     @map("reviewed_by_id")
  reviewedAt   DateTime?   @map("reviewed_at")
  reviewNote   String?     @map("review_note") @db.Text
  createdAt    DateTime    @default(now()) @map("created_at")

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("ProofReviewer", fields: [reviewedById], references: [id])

  @@index([orderId])
  @@index([sha256])
  @@map("payment_proofs")
}

model Delivery {
  id             String         @id @default(cuid())
  orderItemId    String         @map("order_item_id")
  serverId       String?        @map("server_id")
  command        String         @db.Text
  status         DeliveryStatus @default(QUEUED)
  attempts       Int            @default(0)
  lastError      String?        @map("last_error") @db.Text
  executedAt     DateTime?      @map("executed_at")
  deliveredAt    DateTime?      @map("delivered_at")
  idempotencyKey String         @unique @map("idempotency_key")
  createdAt      DateTime       @default(now()) @map("created_at")

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  server    Server?   @relation(fields: [serverId], references: [id])

  @@index([status])
  @@map("deliveries")
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  value         Int
  maxUses       Int?       @map("max_uses")
  usedCount     Int        @default(0) @map("used_count")
  perUserLimit  Int        @default(1) @map("per_user_limit")
  minOrderMinor BigInt?    @map("min_order_minor")
  startsAt      DateTime?  @map("starts_at")
  endsAt        DateTime?  @map("ends_at")
  active        Boolean    @default(true)

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String   @map("coupon_id")
  userId    String   @map("user_id")
  orderId   String   @map("order_id")
  createdAt DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@map("coupon_redemptions")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  link      String?
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Server {
  id              String  @id @default(cuid())
  name            String
  provider        String  @default("MANUAL")
  host            String?
  port            Int?
  secretEncrypted String? @map("secret_encrypted") @db.Text
  status          String  @default("UNKNOWN")

  products   Product[]
  deliveries Delivery[]

  @@map("servers")
}
