# Local development only. Replace every value before deploying.
APP_NAME="HFQ Dash"
APP_URL="http://localhost:3000"
NODE_ENV=development

# Auth / crypto (generate fresh, never reuse values from other projects)
AUTH_SECRET=""
ENCRYPTION_KEY=""

# MySQL
DATABASE_URL="mysql://username:password@localhost:3306/database_name"

# Resend (email sending)
RESEND_API_KEY=""
EMAIL_FROM="HFQ Network <noreply@hfqmc.xyz>"
EMAIL_REPLY_TO="support@hfqmc.xyz"

# Super admin seed
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# Uploads
UPLOAD_DIR="./var/uploads"
MAX_UPLOAD_MB=10

# Jobs
CRON_SECRET=""

# Optional integrations
DISCORD_WEBHOOK_URL=""
PTERODACTYL_URL=""
PTERODACTYL_API_KEY=""
RCON_HOST=""
RCON_PORT=25575
RCON_PASSWORD=""

# Store
NEXT_PUBLIC_STORE_URL="https://hfqmc.xyz"

# Local design preview without MySQL. Remove this line when the database is ready.
# Never enable in production.
# DEMO_MODE=1
